# ============================================
# 🔥 FIREBASE CONFIGURATION
# ============================================
# Obtén estas credenciales desde Firebase Console:
# https://console.firebase.google.com/
# 
# 1. Ve a tu proyecto Firebase
# 2. Configuración del proyecto (⚙️) → Configuración general
# 3. En "Tus aplicaciones", selecciona tu app web
# 4. Copia las credenciales aquí

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://tu_proyecto-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ============================================
# 🤖 GOOGLE GEMINI AI
# ============================================
# Obtén tu API key desde:
# https://aistudio.google.com/app/apikey

GEMINI_API_KEY=tu_gemini_api_key_aqui

# ============================================
# 📝 INSTRUCCIONES
# ============================================
# 1. Copia este archivo como .env.local
# 2. Reemplaza todos los valores con tus credenciales reales
# 3. NUNCA subas .env.local a Git (ya está en .gitignore)
# 4. Para producción, configura estas variables en tu plataforma de hosting













