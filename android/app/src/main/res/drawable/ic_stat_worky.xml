<?xml version="1.0" encoding="utf-8"?>
<!--
  El icono de las notificaciones, en la barra de estado.

  Android ahí solo pinta siluetas: toma el canal alfa del icono y lo rellena de
  blanco. Sin esto usaba el icono de la app, que es a color y opaco de borde a
  borde, y salía un cuadrado blanco en vez de la W.

  Es la W del logo a trazo grueso y con las puntas redondeadas, sin el cruce
  del centro: a 24 dp ese detalle no se distingue y solo emborrona la letra.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5,8.3 L8.55,15.6 L12,8.3 L15.45,15.6 L19,8.3"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
